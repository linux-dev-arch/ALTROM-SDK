#include "../../sdk/sdk.h"

#define CH8_CODE   0x002DA200
#define CH8_MEM        ((volatile uint8_t *)CH8_CODE)
#define CH8_REG_ADDR    0x002DB200
#define CH8_REG        ((volatile uint8_t *)CH8_REG_ADDR)
#define CH8_STACK_ADDR  0x002DB210
#define CH8_STACK       ((volatile uint16_t *)CH8_STACK_ADDR)
void main(void){
	volatile uint8_t *ch8_mem=CH8_MEM;
	volatile uint8_t *ch8_reg=CH8_REG;
	volatile uint16_t *ch8_stack=CH8_STACK;
	uint8_t sp=0;
	uint16_t pc=0x200;
	uint16_t reg_I = 0;
	uint16_t delay_timer=0;
	uint16_t sound_timer=0;
	for(int i=0;i<4096;i++){
		ch8_mem[i]=0;//ZERO OUT THE RAM
	}
	for(int i=0;i<16;i++){
                ch8_reg[i]=0;//ZERO OUT THE REGISTERS
        }
	for(int i=0;i<16;i++){
                ch8_stack[i]=0;//ZERO OUT THE STACK
        }
	while(KP_LEFT!=0){
		instr = (ch8_mem[pc]<<8) | ch8_mem[pc+1];
		uint8_t opcode_type = (instr&0xF000) >> 12;
		switch(opcode_type){
			case 0x0:
				if(instr==0x00E0){
					//clear display
					fb_clear(COL_BLACK);
					fb_flush();
					pc+=2;
				}
				else if(instr ==0x00EE){
					//return
					sp--;
					pc=ch8_stack[sp];
					pc+=2;
				}
				break;
			case 0x1:
				//jump
				pc=instr & 0x0FFF;
				break;
			case 0x2:
				//call SUB
				ch8_stack[sp]=pc;
				sp++;
				pc=instr & 0x0FFF;
				break;
			case 0x3:{
				//JMP IF VX == NN
				uint8_t reg = (instr>>8) & 0xF;
				uint16_t NN = instr & 0xFF;
				if(ch8_reg[reg]==NN){
					pc+=4;
				}
				else{
					pc+=2;
				}
				break;
			}
			case 0x4:{
                                //JMP IF VX != NN
                                uint8_t reg = (instr>>8) & 0xF;
                                uint16_t NN = instr & 0xFF;
                                if(ch8_reg[reg]!=NN){
                                        pc+=4;
                                }
                                else{
                                        pc+=2;
                                }
                                break;
                        }
			case 0x5:{
                                //JMP IF VX == VY
                                uint8_t VX = (instr>>16) & 0xF;
                                uint8_t VY = (instr>>8) & 0xF;
                                if(ch8_reg[VX]==ch8_reg[VY]){
                                        pc+=4;
                                }
                                else{
                                        pc+=2;
                                }
                                break;
                        }
			case 0x6:{
				//SET VX to NN
				uint8_t VX = (instr>>16) & 0xF;
				ch8_reg[VX]=instr & 0xFF;
				pc+=2;
				break;
			}
			case 0x7:{
				//ADDNN
				uint8_t VX = (instr>>16) & 0xF;
                                uint16_t NN = instr & 0xFF;
				ch8_reg[VX]+=NN;
				pc+=2;
				break;
			}
			case 0x8:{
				uint8_t opp = instr & 0xF;
				uint8_t VX = (instr>>16) & 0xF;
                                uint8_t VY = (instr>>8) & 0xF;
				if(opp==0){
					//SET VX TO VY
					ch8_reg[VX]=ch8_reg[VY];
				}
				else if(opp==1){
					//SET VX TO VY OR
					ch8_reg[VX]|=ch8_reg[VY];
				}
				else if(opp==2){
					//SET VX TO VY AND
					ch8_reg[VX]&=ch8_reg[VY];
				}
				else if(opp==3){
					//SET VX TO VY XOR
					ch8_reg[VX]^=ch8_reg[VY];
				}
				else if(opp==4){
					//ADD VY TO VX
					uint16_t val =ch8_reg[VX]+ch8_reg[VY];
					if(val > 0xff){
						ch8_reg[0xf]=1;
					}
					else{
						ch8_reg[0xf]=0;
					}
					ch8_reg[VX]+=ch8_reg[VY];
				}
				else if(opp==5){
					//SUB VY FROM VX
					int16_t val =ch8_reg[VX]-ch8_reg[VY];
					if(val <0){
                                                ch8_reg[0xf]=0;
                                        }
                                        else{
                                                ch8_reg[0xf]=1;
                                        }
                                        ch8_reg[VX]-=ch8_reg[VY];
				}
				else if(opp==6){
					//SHIFT VX
					uint8_t lsb = ch8_reg[VX] & 0x1;
					ch8_reg[VX]>>=1;
				}
				else if(opp==7){
					//VX =  VY - VX
					int16_t val =ch8_reg[VY]-ch8_reg[VX];
                                        if(val <0){
                                                ch8_reg[0xf]=0;
                                        }
                                        else{
                                                ch8_reg[0xf]=1;
                                        }
                                        ch8_reg[VX]=ch8_reg[VY]-ch8_reg[VX];
				}
				else if(opp==0xE){
					//SHIFT LEFT
					ch8_reg[0xF]=ch8_reg[VX] & 0x80;
					ch8_reg[VX] <<=1;
				}
				pc+=2;
				break;
			}
			case 0x9:{//SKIP IF VX!=VY
				uint8_t VX = (instr>>16) & 0xF;
                                uint8_t VY = (instr>>8) & 0xF;
				if(ch8_reg[VX] != ch8_reg[VY]){
					pc+=4;
				}
				else{
					pc+=2;
				}
				break;
			}
			case 0xA:{//SET REG_I TO NNN
				uint16_t nnn = instr & 0x0FFF;
				reg_I = nnn;
				pc+=2;
				break;
			}
			case 0xB:{
				uint16_t nnn = instr & 0x0FFF;
				pc=ch8_reg[0]+nnn;
				break;
			}
			case 0xC:{
				ch8_reg[VX] = 46 & (instr&0xFF)//i chose 46 as a random number :)
				pc+=2;
				break;
			}
			case 0xD:{
				//FIXME:handle this later
				break;
			}
			case 0xE:{
				uint16_t sub = instr & 0xff;
				if(sub==0x9E){
					//SKIP NXT if key in VX is pressed
					//FIXME handle this
				}
				else if(sub==0xA1){
					//SKIP NEXT IF KEY IN VX IS NOT PRESSED
					//FIXME handle this
				}
				pc+=2;
				break;
			}
			case 0xF:{
				uint8_t VX = (instr>>16)&0xf;
				uint16_t sub = instr & 0xff;
				if(sub==0x07){
					//sets VX TO delay timer
					ch8_reg[VX]=delay_timer;
				}
				else if(sub==0x0A){
					//gets key and puts it into VX
					//FIXME handle it
				}
				else if(sub==0x15){
					//SET delay timer to VX
					delay_timer=ch8_reg[VX];
				}
				else if(sub==0x18){
					sound_timer=ch8_reg[VX];
				}
				else if(sub==0x1E){
					reg_I += ch8_reg[VX];
				}
				else if(sub==0x29){
					//sprite address
					//FIXME handle it
				}
				else if(sub==0x33){
					//BCD
					//FIXME handle it
				}
				else if(sub==0x55){
					//regdump
					//FIXME handle it
				}
				else if(sub==0x65){
					//reg_load
					//FIXME handle it
				}
				pc+=2;
				break;
			}
		}
	}
}
